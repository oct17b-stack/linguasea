# Copy to .env (never commit it). All values are optional for local development.
PORT=8080

# Reverse proxies in front of the server (the platform's router / load balancer). Rate limits use the client IP
# from X-Forwarded-For only this many hops deep, so clients cannot fake it. 0 = clients connect directly.
TRUST_PROXY=1

# New anonymous accounts per client IP per hour (default 20). Raise it if many learners share one
# carrier-grade NAT address and installs get 429.
ACCOUNTS_PER_IP_PER_HOUR=20

# PostgreSQL, e.g. postgres://user:password@host:5432/linguasea — without it data is kept in memory only.
DATABASE_URL=

# Azure AI Speech resource (pronunciation scoring; the same key generates audio with tools/audio).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia

# Anthropic API key for the AI conversation tutor (off when empty). TUTOR_MODEL overrides the default claude-opus-5-5.
ANTHROPIC_API_KEY=
TUTOR_MODEL=
TUTOR_FREE_PER_DAY=6
TUTOR_PREMIUM_PER_DAY=30

# Exact Authorization header value RevenueCat sends with webhooks (set the same value in the RevenueCat dashboard).
REVENUECAT_WEBHOOK_AUTH=

# Email sign-in codes are sent with Resend (https://resend.com): API key and a sender on a verified domain,
# e.g. MAIL_FROM=LinguaSEA <login@mail.example.com>. Without them codes are printed to the log in development
# ("[mail] login code for …") and email sign-in answers 503 when NODE_ENV=production.
RESEND_API_KEY=
MAIL_FROM=

# Daily pronunciation scoring limits per account.
PRONUNCIATION_FREE_PER_DAY=10
PRONUNCIATION_PREMIUM_PER_DAY=200

# Daily limits (scoring, tutor, voice input) start over at midnight in this IANA time zone. A failed call is not counted.
QUOTA_TIME_ZONE=Asia/Bangkok

# Defaults: <repo>/content, <repo>/content/audio, <repo>/server/public and <repo>/app/dist
# WEB_DIR is the web build of the app (served at /app/; not served when the folder is missing).
CONTENT_DIR=
AUDIO_DIR=
PUBLIC_DIR=
WEB_DIR=
