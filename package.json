{
  "name": "linguasea",
  "private": true,
  "workspaces": [
    "app",
    "packages/*",
    "server",
    "tools"
  ],
  "scripts": {
    "content": "npm run build --workspace @linguasea/contract",
    "validate": "npm run validate --workspace @linguasea/contract --",
    "audio": "npm run audio --workspace @linguasea/tools --",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check": "npm run validate && npm run content && npm run typecheck && npm test",
    "l10n": "npm run l10n --workspace @linguasea/contract --",
    "hours": "npm run hours --workspace @linguasea/tools --",
    "dupes": "npm run dupes --workspace @linguasea/contract --",
    "plan:apply": "npm run plan:apply --workspace @linguasea/tools --",
    "e2e": "node tests/e2e/run.mjs"
  },
  "devDependencies": {
    "playwright": "1.56.1"
  }
}
