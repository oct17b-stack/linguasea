    {
      "id": "ko.gukbap",
      "text": "국밥",
      "reading": "gukbap"
    },
    {
      "id": "ko.sundubujjigae",
      "text": "순두부찌개",
      "reading": "sundubujjigae"
    },
    {
      "id": "ko.gimchijjigae",
      "text": "김치찌개",
      "reading": "gimchijjigae"
    },
    {
      "id": "ko.doenjangjjigae",
      "text": "된장찌개",
      "reading": "doenjangjjigae"
    }
  ],
  "dialogue": [
    {
      "speaker": "a",
      "text": "민준 씨, 김치찌개 먹어요?",
      "reading": "Minjun ssi, gimchijjigae meogeoyo?"
    },
    {
      "speaker": "b",
      "text": "김치찌개는 좀 매워요. 순두부찌개는 어때요?",
      "reading": "Gimchijjigaeneun jom maewoyo. Sundubujjigaeneun eottaeyo?"
    },
    {
      "speaker": "a",
      "text": "순두부찌개도 매워요. 된장찌개는 안 매워요.",
      "reading": "Sundubujjigaedo maewoyo. Doenjangjjigaeneun an maewoyo."
    },
    {
      "speaker": "b",
      "text": "그래요? 저는 된장찌개 먹고 싶어요.",
      "reading": "Geuraeyo? Jeoneun doenjangjjigae meokgo sipeoyo."
    },
    {
      "speaker": "a",
      "text": "저는 국밥 먹어요. 저기요! 된장찌개 하나, 국밥 하나 주세요.",
      "reading": "Jeoneun gukbap meogeoyo. Jeogiyo! Doenjangjjigae hana, gukbap hana juseyo."
    },
    {
      "speaker": "c",
      "text": "네, 잠깐만요!",
      "reading": "Ne, jamkkanmanyo!"
    }
  ]
}
