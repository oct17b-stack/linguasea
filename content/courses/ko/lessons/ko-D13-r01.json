  "passage": [
    [
      {
        "text": "방콕은 태국의 수도이고 가장 큰 도시예요.",
        "reading": "Bangkogeun Taegugui sudoigo gajang keun dosiyeyo."
      },
      {
        "text": "태국 사람들은 이 도시를 '끄룽텝'이라고 불러요.",
        "reading": "Taeguk saramdeureun i dosireul 'Kkeurungtep'irago bulleoyo."
      },
      {
        "text": "끄룽텝은 한국어로 하면 '천사의 도시'예요.",
        "reading": "Kkeurungtebeun hangugeoro hamyeon 'cheonsaui dosi'yeyo."
      }
    ],
    [
      {
        "text": "옛날에 방콕에는 운하가 아주 많았어요.",
        "reading": "Yennare Bangkogeneun unhaga aju manasseoyo."
      },
      {
        "text": "그래서 사람들은 배를 타고 다녔어요.",
        "reading": "Geuraeseo saramdeureun baereul tago danyeosseoyo."
      },
      {
        "text": "지금도 짜오프라야강과 운하에서 수상 버스를 탈 수 있어요.",
        "reading": "Jigeumdo Jjaopeurayaganggwa unhaeseo susang beoseureul tal su isseoyo."
      },
      {
        "text": "방콕에는 수많은 사원이 있어요.",
        "reading": "Bangkogeneun sumaneun sawoni isseoyo."
      },
      {
        "text": "태국에서는 불교가 아주 중요해요.",
        "reading": "Taegugeseoneun bulgyoga aju jungyohaeyo."
      }
    ],
    [
      {
        "text": "방콕에서 가장 유명한 곳은 왕궁이에요.",
        "reading": "Bangkogeseo gajang yumyeonghan goseun wanggungieyo."
      },
      {
        "text": "왕궁 안에는 아름다운 사원도 있어요.",
        "reading": "Wanggung aneneun areumdaun sawondo isseoyo."
      },
      {
        "text": "왕궁에 갈 때는 짧은 바지나 짧은 치마를 입으면 안 돼요.",
        "reading": "Wanggunge gal ttaeneun jjalbeun bajina jjalbeun chimareul ibeumyeon an dwaeyo."
      },
      {
        "text": "방콕에서는 옛날 도시와 새 도시를 함께 볼 수 있어요.",
        "reading": "Bangkogeseoneun yennal dosiwa sae dosireul hamkke bol su isseoyo."
      }
    ]
  ],
