  "passage": [
    [
      {
        "text": "신촌역 역세권 풀옵션 원룸이에요!",
        "reading": "Sinchonnyeok yeoksegwon puropsyeon wonrumieyo!"
      },
      {
        "text": "신촌역에서 걸어서 오 분 걸려요.",
        "reading": "Sinchonnyeogeseo georeoseo o bun geollyeoyo."
      },
      {
        "text": "학교도 가까워요.",
        "reading": "Hakgyodo gakkawoyo."
      }
    ],
    [
      {
        "text": "방에는 침대하고 옷장이 놓여 있어요.",
        "reading": "Bangeneun chimdaehago otjangi noyeo isseoyo."
      },
      {
        "text": "냉장고, 세탁기, 에어컨도 다 있어요.",
        "reading": "Naengjanggo, setakgi, eeokeondo da isseoyo."
      },
      {
        "text": "인터넷도 연결되어 있어요.",
        "reading": "Inteonetdo yeongyeoldoeeo isseoyo."
      },
      {
        "text": "풀옵션이니까 가구를 안 사도 돼요!",
        "reading": "Puropsyeoninikka gagureul an sado dwaeyo!"
      }
    ],
    [
      {
        "text": "보증금은 500만 원, 월세는 45만 원이에요.",
        "reading": "Bojeunggeumeun obaengman won, wolseneun sasiboman wonieyo."
      },
      {
        "text": "관리비는 5만 원이고 인터넷이 포함되어 있어요.",
        "reading": "Gwallibineun oman wonigo inteonesi pohamdoeeo isseoyo."
      },
      {
        "text": "즉시 입주할 수 있어요.",
        "reading": "Jeuksi ipjuhal su isseoyo."
      },
      {
        "text": "관심이 있으면 신촌 부동산으로 연락하세요.",
        "reading": "Gwansimi isseumyeon Sinchon budongsaneuro yeollakaseyo."
      }
