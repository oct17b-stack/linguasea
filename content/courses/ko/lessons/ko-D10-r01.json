  "passage": [
    [
      {
        "text": "방학에 방콕에 있는 우리 집에 왔어요.",
        "reading": "Banghage Bangkoge inneun uri jibe wasseoyo."
      },
      {
        "text": "오늘 제 방을 정리하다가 옛날 일기장을 찾았어요.",
        "reading": "Oneul je bangeul jeongnihadaga yennal ilgijangeul chajasseoyo."
      },
      {
        "text": "열 살 때 쓴 일기장이었어요.",
        "reading": "Yeol sal ttae sseun ilgijangieosseoyo."
      }
    ],
    [
      {
        "text": "일기장을 열어 보니까 글씨가 정말 크고 이상했어요.",
        "reading": "Ilgijangeul yeoreo bonikka geulssiga jeongmal keugo isanghaesseoyo."
      },
      {
        "text": "쓴 이야기도 정말 웃겼어요.",
        "reading": "Sseun iyagido jeongmal utgyeosseoyo."
      },
      {
        "text": "어느 날은 동생이 제 과자를 먹어서 동생하고 싸웠어요.",
        "reading": "Eoneu nareun dongsaengi je gwajareul meogeoseo dongsaenghago ssawosseoyo."
      },
      {
        "text": "그때 저는 아이돌이 되고 싶었어요.",
        "reading": "Geuttae jeoneun aidori doego sipeosseoyo."
      },
      {
        "text": "그래서 매일 방에서 노래를 부르고 춤을 췄어요.",
        "reading": "Geuraeseo maeil bangeseo noraereul bureugo chumeul chwosseoyo."
      }
    ],
    [
      {
        "text": "일기를 읽으면서 혼자 많이 웃었어요.",
        "reading": "Ilgireul ilgeumyeonseo honja mani useosseoyo."
      },
      {
        "text": "그리고 동생에게 일기장을 보여 줬어요.",
        "reading": "Geurigo dongsaengege ilgijangeul boyeo jwosseoyo."
      },
      {
        "text": "동생도 그날 일을 기억하고 있었어요.",
        "reading": "Dongsaengdo geunal ireul gieokago isseosseoyo."
      },
      {
        "text": "어린 시절이 조금 그리워요.",
        "reading": "Eorin sijeori jogeum geuriwoyo."
      }
