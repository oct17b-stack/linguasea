  "dialogue": [
    {
      "speaker": "b",
      "text": "남 씨, 오늘 기분 어때요?",
      "reading": "Nam ssi, oneul gibun eottaeyo?"
    },
    {
      "speaker": "a",
      "text": "좀 피곤해요. 민준 씨는요?",
      "reading": "Jom pigonhaeyo. Minjun ssineunyo?"
