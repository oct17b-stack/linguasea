      "id": "ko.binson",
      "text": "빈손",
      "reading": "binson"
    },
    {
      "id": "ko.budam",
      "text": "부담",
      "reading": "budam"
    },
    {
      "id": "ko.jeongseong",
      "text": "정성",
      "reading": "jeongseong"
    },
    {
      "id": "ko.kkotdabal",
      "text": "꽃다발",
      "reading": "kkotdabal"
    }
  ],
  "dialogue": [
    {
      "speaker": "a",
      "text": "민준 씨, 집들이 선물로 뭐가 좋아요?",
      "reading": "Minjun ssi, jipdeuri seonmullo mwoga joayo?"
    },
    {
      "speaker": "b",
      "text": "선물은 사지 말고 그냥 오세요.",
      "reading": "Seonmureun saji malgo geunyang oseyo."
    },
    {
      "speaker": "a",
      "text": "그래도 빈손으로 가요? 좀 이상해요.",
      "reading": "Geuraedo binsoneuro gayo? Jom isanghaeyo."
    },
    {
      "speaker": "b",
      "text": "정말 괜찮아요. 남 씨한테 부담을 주고 싶지 않아요.",
      "reading": "Jeongmal gwaenchanayo. Nam ssihante budameul jugo sipji anayo."
    },
    {
      "speaker": "a",
      "text": "그럼 비싼 거 사지 말고 꽃다발을 살게요.",
      "reading": "Geureom bissan geo saji malgo kkotdabareul salgeyo."
    },
    {
      "speaker": "b",
      "text": "하하, 알겠어요. 고마워요.",
      "reading": "Haha, algesseoyo. Gomawoyo."
    },
    {
      "speaker": "a",
      "text": "아니에요. 작은 선물이지만 제 정성이에요.",
      "reading": "Anieyo. Jageun seonmurijiman je jeongseongieyo."
    },
    {
      "speaker": "b",
      "text": "그럼 토요일에 기다릴게요!",
      "reading": "Geureom toyoire gidarilgeyo!"
    }
  ]
}
