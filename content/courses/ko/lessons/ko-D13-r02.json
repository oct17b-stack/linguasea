  "passage": [
    [
      {
        "text": "남 씨, 잘 지내요?",
        "reading": "Nam ssi, jal jinaeyo?"
      },
      {
        "text": "저는 지난주에 치앙마이 여행을 다녀왔어요.",
        "reading": "Jeoneun jinanjue Chiangmai yeohaengeul danyeowasseoyo."
      },
      {
        "text": "남 씨가 추천해 준 곳에 다 가 봤어요.",
        "reading": "Nam ssiga chucheonhae jun gose da ga bwasseoyo."
      }
    ],
    [
      {
        "text": "치앙마이는 방콕만큼 크지 않지만 볼거리가 많았어요.",
        "reading": "Chiangmaineun Bangkongmankeum keuji anchiman bolgeoriga manasseoyo."
      },
      {
        "text": "특히 산 위에 있는 사원이 정말 인상적이었어요.",
        "reading": "Teuki san wie inneun sawoni jeongmal insangjeogieosseoyo."
      },
      {
        "text": "사원에서 본 도시의 경치도 아름다웠어요.",
        "reading": "Sawoneseo bon dosiui gyeongchido areumdawosseoyo."
      },
      {
        "text": "치앙마이 사람들은 소박하고 친절했어요.",
        "reading": "Chiangmai saramdeureun sobakago chinjeolhaesseoyo."
      },
      {
        "text": "아침에는 작은 카페에서 커피를 마시면서 여유로운 시간을 보냈어요.",
        "reading": "Achimeneun jageun kapeeseo keopireul masimyeonseo yeoyuroun siganeul bonaesseoyo."
      }
    ],
    [
      {
        "text": "남 씨 덕분에 정말 즐거운 여행이었어요.",
        "reading": "Nam ssi deokbune jeongmal jeulgeoun yeohaengieosseoyo."
      },
      {
        "text": "기념품으로 치앙마이 커피를 샀어요.",
        "reading": "Ginyeompumeuro Chiangmai keopireul sasseoyo."
      },
      {
        "text": "남 씨 것도 샀어요.",
        "reading": "Nam ssi geotdo sasseoyo."
      },
      {
        "text": "다음 수업 때 같이 마셔요.",
        "reading": "Daeum sueop ttae gachi masyeoyo."
      },
      {
        "text": "그럼 월요일에 만나요.",
        "reading": "Geureom woryoire mannayo."
      }
    ]
  ],
