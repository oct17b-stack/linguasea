  "dialogue": [
    {
      "speaker": "b",
      "text": "성이 뭐예요?",
      "reading": "Seongi mwoyeyo?"
    },
    {
      "speaker": "a",
      "text": "제 성은 좀 길어요. 영문으로 써요?",
      "reading": "Je seongeun jom gireoyo. Yeongmuneuro sseoyo?"
    },
    {
      "speaker": "b",
      "text": "네, 영문으로 써요. 국적은 태국이에요?",
      "reading": "Ne, yeongmuneuro sseoyo. Gukjeogeun Taegugieyo?"
    },
    {
      "speaker": "a",
      "text": "네, 태국이에요. 이거는 뭐예요?",
      "reading": "Ne, Taegugieyo. Igeoneun mwoyeyo?"
    },
    {
      "speaker": "b",
      "text": "남성, 여성이에요. 남자, 여자예요.",
      "reading": "Namseong, yeoseongieyo. Namja, yeojayeyo."
    },
    {
      "speaker": "a",
      "text": "아, 알겠어요!",
      "reading": "A, algesseoyo!"
    }
  ]
