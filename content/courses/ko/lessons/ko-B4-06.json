  "dialogue": [
    {
      "speaker": "a",
      "text": "저기요, 동대문 시장에 어떻게 가요?",
      "reading": "Jeogiyo, Dongdaemun sijange eotteoke gayo?"
    },
    {
      "speaker": "b",
      "text": "저기 정류장에서 칠 번 버스를 타요.",
      "reading": "Jeogi jeongnyujangeseo chil beon beoseureul tayo."
    },
    {
      "speaker": "a",
      "text": "버스가 동대문까지 가요?",
      "reading": "Beoseuga Dongdaemunkkaji gayo?"
    },
    {
      "speaker": "b",
      "text": "아니요, 역에서 지하철 일 호선으로 갈아타요.",
      "reading": "Aniyo, yeogeseo jihacheol il hoseoneuro garatayo."
    },
    {
      "speaker": "a",
      "text": "동대문에서 내려요?",
      "reading": "Dongdaemuneseo naeryeoyo?"
    },
    {
      "speaker": "b",
      "text": "네. 아, 교통 카드 있어요?",
      "reading": "Ne. A, gyotong kadeu isseoyo?"
