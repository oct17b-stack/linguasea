  ],
  "dialogue": [
    {
      "speaker": "b",
      "text": "남 씨, 배가 아파요? 약 먹어요?",
      "reading": "Nam ssi, baega apayo? Yak meogeoyo?"
    },
    {
      "speaker": "a",
      "text": "아니요, 약이 없어요. 약국에 가요.",
      "reading": "Aniyo, yagi eopseoyo. Yakguge gayo."
    },
    {
      "speaker": "b",
      "text": "잠깐만요. 저한테 한국 소화제가 있어요.",
      "reading": "Jamkkanmanyo. Jeohante Hanguk sohwajega isseoyo."
    },
    {
      "speaker": "a",
      "text": "와, 고마워요! 하루에 몇 번 먹어요?",
      "reading": "Wa, gomawoyo! Harue myeot beon meogeoyo?"
    },
    {
      "speaker": "b",
      "text": "하루에 세 번 먹어요. 진통제하고 해열제도 있어요.",
      "reading": "Harue se beon meogeoyo. Jintongjehago haeyeoljedo isseoyo."
    },
    {
      "speaker": "a",
      "text": "괜찮아요. 소화제 주세요.",
      "reading": "Gwaenchanayo. Sohwaje juseyo."
    }
  ]
}
