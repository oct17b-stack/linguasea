  "dialogue": [
    {
      "speaker": "c",
      "text": "남 씨, 감기 괜찮아요?",
      "reading": "Nam ssi, gamgi gwaenchanayo?"
    },
    {
      "speaker": "a",
      "text": "아니요, 기침을 많이 해요.",
      "reading": "Aniyo, gichimeul mani haeyo."
    },
    {
      "speaker": "c",
      "text": "아이고, 오늘은 집에서 푹 쉬세요.",
      "reading": "Aigo, oneureun jibeseo puk swiseyo."
    },
    {
      "speaker": "a",
      "text": "네, 선생님. 감사합니다.",
      "reading": "Ne, seonsaengnim. Gamsahamnida."
    },
    {
      "speaker": "c",
      "text": "빨리 나으세요. 건강이 제일이에요!",
      "reading": "Ppalli naeuseyo. Geongangi jeirieyo!"
    },
    {
      "speaker": "a",
      "text": "네! 선생님도 감기 조심하세요.",
      "reading": "Ne! Seonsaengnimdo gamgi josimhaseyo."
