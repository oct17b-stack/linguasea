  "dialogue": [
    {
      "speaker": "a",
      "text": "王明，菜单在这儿。你吃什么？",
      "reading": "Wáng Míng, càidān zài zhèr. Nǐ chī shénme?"
    },
    {
      "speaker": "b",
      "text": "我要炒饭。你呢？",
      "reading": "Wǒ yào chǎofàn. Nǐ ne?"
    },
    {
      "speaker": "a",
      "text": "我要米粉，还要一个汤。",
      "reading": "Wǒ yào mǐfěn, hái yào yī ge tāng."
    },
    {
      "speaker": "c",
      "text": "米粉要辣的吗？",
      "reading": "Mǐfěn yào là de ma?"
    },
    {
      "speaker": "a",
      "text": "要！我很喜欢辣的。",
      "reading": "Yào! Wǒ hěn xǐhuan là de."
    },
    {
      "speaker": "b",
      "text": "我不吃辣的！",
      "reading": "Wǒ bù chī là de!"
    }
