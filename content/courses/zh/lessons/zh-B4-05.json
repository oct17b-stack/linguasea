  "dialogue": [
    {
      "speaker": "b",
      "text": "小南，你每天早上做什么？",
      "reading": "Xiǎonán, nǐ měitiān zǎoshang zuò shénme?"
    },
    {
      "speaker": "a",
      "text": "起床，洗澡，刷牙，吃早饭。",
      "reading": "Qǐchuáng, xǐzǎo, shuāyá, chī zǎofàn."
    },
    {
      "speaker": "b",
      "text": "早上洗澡？我晚上洗澡。",
      "reading": "Zǎoshang xǐzǎo? Wǒ wǎnshang xǐzǎo."
    },
    {
      "speaker": "a",
      "text": "我晚上回家也洗澡！",
      "reading": "Wǒ wǎnshang huí jiā yě xǐzǎo!"
    },
    {
      "speaker": "b",
      "text": "早上洗，晚上也洗？",
      "reading": "Zǎoshang xǐ, wǎnshang yě xǐ?"
    },
    {
      "speaker": "a",
      "text": "对！泰国人早上晚上都洗。",
      "reading": "Duì! Tàiguó rén zǎoshang wǎnshang dōu xǐ."
    }
  ]
