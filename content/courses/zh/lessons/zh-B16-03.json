  "dialogue": [
    {
      "speaker": "b",
      "text": "喂，小南，你今天怎么样？",
      "reading": "Wéi, Xiǎonán, nǐ jīntiān zěnmeyàng?"
    },
    {
      "speaker": "a",
      "text": "好多了，谢谢！",
      "reading": "Hǎo duō le, xièxie!"
    },
    {
      "speaker": "b",
      "text": "体温呢？还高吗？",
      "reading": "Tǐwēn ne? Hái gāo ma?"
    },
    {
      "speaker": "a",
      "text": "不高了。大夫说我最好在家休息两天。",
      "reading": "Bù gāo le. Dàifu shuō wǒ zuìhǎo zài jiā xiūxi liǎng tiān."
    },
    {
      "speaker": "b",
      "text": "好，你要多喝水！",
      "reading": "Hǎo, nǐ yào duō hē shuǐ!"
    },
    {
      "speaker": "a",
      "text": "知道，知道！你和我妈妈说的一样！",
      "reading": "Zhīdào, zhīdào! Nǐ hé wǒ māma shuō de yīyàng!"
    }
  ]
