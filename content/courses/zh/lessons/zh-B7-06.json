  "dialogue": [
    {
      "speaker": "c",
      "text": "欢迎光临！",
      "reading": "Huānyíng guānglín!"
    },
    {
      "speaker": "a",
      "text": "你好！我要这个面包和牛奶。",
      "reading": "Nǐ hǎo! Wǒ yào zhège miànbāo hé niúnǎi."
    },
    {
      "speaker": "c",
      "text": "面包要加热吗？",
      "reading": "Miànbāo yào jiārè ma?"
    },
    {
      "speaker": "a",
      "text": "要，谢谢。",
      "reading": "Yào, xièxie."
    },
    {
      "speaker": "c",
      "text": "还要别的吗？要袋子吗？",
      "reading": "Hái yào biéde ma? Yào dàizi ma?"
    },
    {
      "speaker": "a",
      "text": "不要袋子。请给我吸管。",
      "reading": "Bù yào dàizi. Qǐng gěi wǒ xīguǎn."
    }
  ]
}
