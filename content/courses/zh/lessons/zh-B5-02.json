  "dialogue": [
    {
      "speaker": "a",
      "text": "王明，今天会下雨吗？",
      "reading": "Wáng Míng, jīntiān huì xiàyǔ ma?"
    },
    {
      "speaker": "b",
      "text": "不会。今天是晴天。",
      "reading": "Bù huì. Jīntiān shì qíngtiān."
    },
    {
      "speaker": "a",
      "text": "明天呢？",
      "reading": "Míngtiān ne?"
    },
    {
      "speaker": "b",
      "text": "明天会刮风，也会下雨。",
      "reading": "Míngtiān huì guāfēng, yě huì xiàyǔ."
    },
    {
      "speaker": "a",
      "text": "那我明天在家休息。",
      "reading": "Nà wǒ míngtiān zài jiā xiūxi."
    }
