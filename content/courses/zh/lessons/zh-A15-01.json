  "dialogue": [
    {
      "speaker": "a",
      "text": "王明，“南”是什么意思？",
      "reading": "Wáng Míng, “nán” shì shénme yìsi?"
    },
    {
      "speaker": "b",
      "text": "是东南西北的“南”。",
      "reading": "Shì dōng nán xī běi de “nán”."
    },
    {
      "speaker": "a",
      "text": "北京的“北”也是吗？",
      "reading": "Běijīng de “běi” yě shì ma?"
    },
    {
      "speaker": "b",
      "text": "对！我是“北”，你是“南”！",
      "reading": "Duì! Wǒ shì “běi”, nǐ shì “nán”!"
    }
