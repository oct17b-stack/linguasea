      "speaker": "a",
      "text": "火很大！快叫救护车！",
      "reading": "Huǒ hěn dà! Kuài jiào jiùhùchē!"
    },
    {
      "speaker": "b",
      "text": "我打电话！你别去那里！",
      "reading": "Wǒ dǎ diànhuà! Nǐ bié qù nàlǐ!"
    },
    {
      "speaker": "a",
      "text": "好，我去叫人！",
      "reading": "Hǎo, wǒ qù jiào rén!"
