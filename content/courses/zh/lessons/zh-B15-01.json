  "dialogue": [
    {
      "speaker": "a",
      "text": "妈妈，这个周末我和王明去旅行。",
      "reading": "Māma, zhège zhōumò wǒ hé Wáng Míng qù lǚxíng."
    },
    {
      "speaker": "c",
      "text": "去哪儿？",
      "reading": "Qù nǎr?"
    },
    {
      "speaker": "a",
      "text": "去看海，住一晚。",
      "reading": "Qù kàn hǎi, zhù yī wǎn."
    },
    {
      "speaker": "c",
      "text": "那里有空房吗？",
      "reading": "Nàlǐ yǒu kòngfáng ma?"
    },
    {
      "speaker": "a",
      "text": "有，还有两间空房。",
      "reading": "Yǒu, hái yǒu liǎng jiān kòngfáng."
    },
    {
      "speaker": "c",
      "text": "好，一路顺风！",
      "reading": "Hǎo, yīlù shùnfēng!"
    }
  ]
