  "dialogue": [
    {
      "speaker": "c",
      "text": "Nam, how do you go to class?",
      "reading": "ˈnɑːm, ˈhaʊ duː juː ˈɡoʊ tə ˈklæs?"
    },
    {
      "speaker": "a",
      "text": "By bus. Sometimes by motorcycle taxi.",
      "reading": "baɪ ˈbʌs. ˈsʌmtaɪmz baɪ ˈmoʊtərsaɪkəl ˌtæksi."
    },
    {
      "speaker": "c",
      "text": "Motorcycle taxi?",
      "reading": "ˈmoʊtərsaɪkəl ˌtæksi?"
    },
    {
      "speaker": "a",
      "text": "Yes. They're cheap. And you?",
      "reading": "ˈjɛs. ðɛr ˈtʃiːp. ənd ˈjuː?"
    },
    {
      "speaker": "c",
      "text": "I walk, or I go by train.",
      "reading": "aɪ ˈwɔːk, ɔːr aɪ ˈɡoʊ baɪ ˈtreɪn."
    }
  ]
