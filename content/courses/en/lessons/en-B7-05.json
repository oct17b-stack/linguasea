  "dialogue": [
    {
      "speaker": "a",
      "text": "Hi, Emma! Come in!",
      "reading": "ˈhaɪ, ˈɛmə! ˈkʌm ˈɪn!"
    },
    {
      "speaker": "c",
      "text": "Thanks, Nam. Oh, are these slippers for me?",
      "reading": "ˈθæŋks, ˈnɑːm. ˈoʊ, ər ðiːz ˈslɪpərz fər ˈmiː?"
    },
    {
      "speaker": "a",
      "text": "Yes, they are. Have a seat.",
      "reading": "ˈjɛs, ðeɪ ˈɑːr. ˈhæv ə ˈsiːt."
    },
    {
      "speaker": "c",
      "text": "Thank you. Your living room is beautiful!",
      "reading": "ˈθæŋk juː. jʊr ˈlɪvɪŋ ˌruːm ɪz ˈbjuːtəfəl!"
    },
    {
      "speaker": "a",
      "text": "Thanks! Make yourself at home.",
      "reading": "ˈθæŋks! ˈmeɪk jʊrˌsɛlf ət ˈhoʊm."
    },
    {
      "speaker": "c",
      "text": "OK! I love this sofa!",
      "reading": "oʊˈkeɪ! aɪ ˈlʌv ðɪs ˈsoʊfə!"
    }
  ]
