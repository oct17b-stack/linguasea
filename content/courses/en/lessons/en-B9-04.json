    {
      "speaker": "a",
      "text": "Sorry I'm late! I'm on my way.",
      "reading": "ˈsɑːri aɪm ˈleɪt! aɪm ɑːn maɪ ˈweɪ."
    },
    {
      "speaker": "c",
      "text": "Where are you now?",
      "reading": "ˈwɛr ər juː ˈnaʊ?"
    },
    {
      "speaker": "a",
      "text": "I'm on the bus. I'm near the bank.",
      "reading": "aɪm ɑːn ðə ˈbʌs. aɪm ˈnɪr ðə ˈbæŋk."
    },
    {
      "speaker": "c",
      "text": "OK. See you soon!",
      "reading": "oʊˈkeɪ. ˈsiː juː ˈsuːn!"
