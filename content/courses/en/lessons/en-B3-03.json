      "speaker": "a",
      "text": "Excuse me. Where is the supermarket?",
      "reading": "ɪkˈskjuːz miː. ˈwɛr ɪz ðə ˈsuːpərmɑːrkɪt?"
    },
    {
      "speaker": "c",
      "text": "Go straight. Then turn right at the corner.",
      "reading": "ˈɡoʊ ˈstreɪt. ˈðɛn ˈtɜːrn ˈraɪt ət ðə ˈkɔːrnər."
    },
    {
      "speaker": "a",
      "text": "Turn right at the corner?",
      "reading": "ˈtɜːrn ˈraɪt ət ðə ˈkɔːrnər?"
    },
    {
      "speaker": "c",
      "text": "Yes. The supermarket is on the left.",
      "reading": "ˈjɛs. ðə ˈsuːpərmɑːrkɪt ɪz ɑːn ðə ˈlɛft."
    },
    {
      "speaker": "a",
      "text": "Thank you very much!",
      "reading": "ˈθæŋk juː ˈvɛri ˈmʌtʃ!"
    },
