    },
    {
      "speaker": "c",
      "text": "I'm talking to you!",
      "reading": "aɪm ˈtɔːkɪŋ tə ˈjuː!"
    },
    {
      "speaker": "a",
      "text": "Emma! Where are you?",
      "reading": "ˈɛmə! ˈwɛr ər juː?"
    },
