  "dialogue": [
    {
      "speaker": "b",
      "text": "Nam, where do you have lunch?",
      "reading": "ˈnɑːm, ˈwɛr duː juː ˈhæv ˈlʌntʃ?"
    },
    {
      "speaker": "a",
      "text": "At the university.",
      "reading": "ət ðə ˌjuːnɪˈvɜːrsəti."
    },
    {
      "speaker": "b",
      "text": "And in the afternoon?",
      "reading": "ənd ɪn ði ˌæftərˈnuːn?"
    },
    {
      "speaker": "a",
      "text": "I study in the library.",
      "reading": "aɪ ˈstʌdi ɪn ðə ˈlaɪbrɛri."
    },
    {
      "speaker": "b",
      "text": "Do you work, too?",
      "reading": "duː juː ˈwɜːrk, ˈtuː?"
    },
    {
      "speaker": "a",
      "text": "Yes. I work at a restaurant on the weekend.",
      "reading": "ˈjɛs. aɪ ˈwɜːrk ət ə ˈrɛstərɑːnt ɑːn ðə ˈwiːkɛnd."
