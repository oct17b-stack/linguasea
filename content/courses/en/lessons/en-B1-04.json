    {
      "speaker": "c",
      "text": "Nam, when is Mother's Day in Thailand?",
      "reading": "ˈnɑːm, ˈwɛn ɪz ˈmʌðərz ˌdeɪ ɪn ˈtaɪlænd?"
    },
    {
      "speaker": "a",
      "text": "It's in August. And in Canada?",
      "reading": "ɪts ɪn ˈɔːɡəst. ənd ɪn ˈkænədə?"
    },
    {
      "speaker": "c",
      "text": "It's in May.",
      "reading": "ɪts ɪn ˈmeɪ."
    },
    {
      "speaker": "a",
      "text": "And Father's Day is in December.",
      "reading": "ənd ˈfɑːðərz ˌdeɪ ɪz ɪn dɪˈsɛmbər."
    },
    {
      "speaker": "c",
      "text": "In Canada, it's in June.",
