    {
      "speaker": "a",
      "text": "Kenji, this is the student center.",
      "reading": "ˈkɛndʒi, ðɪs ɪz ðə ˈstuːdənt ˌsɛntər."
    },
    {
      "speaker": "b",
      "text": "What's in it?",
      "reading": "ˈwʌts ˈɪn ɪt?"
    },
    {
      "speaker": "a",
      "text": "A bookstore, a computer lab, and a big hall.",
      "reading": "ə ˈbʊkstɔːr, ə kəmˈpjuːtər ˌlæb, ənd ə ˈbɪɡ ˈhɔːl."
    },
    {
      "speaker": "b",
      "text": "Is there a cafeteria, too?",
      "reading": "ɪz ðɛr ə ˌkæfəˈtɪriə, ˈtuː?"
    },
    {
      "speaker": "a",
      "text": "Yes. There's a cafeteria in every building!",
      "reading": "ˈjɛs. ðɛrz ə ˌkæfəˈtɪriə ɪn ˈɛvri ˈbɪldɪŋ!"
    },
    {
      "speaker": "b",
      "text": "Great! I'm hungry. Let's go!",
      "reading": "ˈɡreɪt! aɪm ˈhʌŋɡri. ˈlɛts ˈɡoʊ!"
    }
