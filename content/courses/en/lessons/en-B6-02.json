    {
      "speaker": "c",
      "text": "Is it far from the airport?",
      "reading": "ɪz ɪt ˈfɑːr frəm ði ˈɛrpɔːrt?"
    },
    {
      "speaker": "a",
      "text": "No. The bus stop is in front of the airport.",
      "reading": "ˈnoʊ. ðə ˈbʌs ˌstɑːp ɪz ɪn ˈfrʌnt əv ði ˈɛrpɔːrt."
    },
    {
      "speaker": "c",
      "text": "Do we have bus tickets?",
      "reading": "duː wiː ˈhæv ˈbʌs ˌtɪkɪts?"
