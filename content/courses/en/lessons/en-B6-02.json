  "dialogue": [
    {
      "speaker": "c",
      "text": "Nam, where is our hotel?",
      "reading": "ˈnɑːm, ˈwɛr ɪz aʊər hoʊˈtɛl?"
    },
    {
      "speaker": "a",
      "text": "It's near the station.",
      "reading": "ɪts ˈnɪr ðə ˈsteɪʃən."
