    {
      "speaker": "c",
      "text": "Yes. I go home to Canada every December.",
      "reading": "ˈjɛs. aɪ ˈɡoʊ ˈhoʊm tə ˈkænədə ˈɛvri dɪˈsɛmbər."
    },
    {
      "speaker": "a",
      "text": "By plane?",
      "reading": "baɪ ˈpleɪn?"
    },
    {
      "speaker": "c",
      "text": "Yes. And you, Nam?",
      "reading": "ˈjɛs. ənd ˈjuː, ˈnɑːm?"
