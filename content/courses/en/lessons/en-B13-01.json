  "dialogue": [
    {
      "speaker": "c",
      "text": "Nam? It's Emma. Help!",
      "reading": "ˈnɑːm? ɪts ˈɛmə. ˈhɛlp!"
    },
    {
      "speaker": "a",
      "text": "Oh no! Are you OK?",
      "reading": "ˈoʊ ˈnoʊ! ər juː oʊˈkeɪ?"
    },
    {
      "speaker": "c",
      "text": "I'm OK. Can you help me? I'm at a big market.",
      "reading": "aɪm oʊˈkeɪ. kən juː ˈhɛlp miː? aɪm ət ə ˈbɪɡ ˈmɑːrkɪt."
    },
    {
      "speaker": "a",
      "text": "Sure. Which market?",
      "reading": "ˈʃʊr. ˈwɪtʃ ˈmɑːrkɪt?"
    },
    {
      "speaker": "c",
      "text": "I don't know. It's next to a temple.",
      "reading": "aɪ ˈdoʊnt ˈnoʊ. ɪts ˈnɛkst tə ə ˈtɛmpəl."
    },
    {
      "speaker": "a",
      "text": "OK. Stay there, Emma. I'm coming!",
      "reading": "oʊˈkeɪ. ˈsteɪ ˈðɛr, ˈɛmə. aɪm ˈkʌmɪŋ!"
