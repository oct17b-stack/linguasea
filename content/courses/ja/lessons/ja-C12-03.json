  "dialogue": [
    {
      "speaker": "a",
      "text": "すみません。なかみは われものです。もう すこし つつんで くださいませんか。",
      "reading": "Sumimasen. Nakami wa waremono desu. Mō sukoshi tsutsunde kudasaimasen ka."
    },
    {
      "speaker": "b",
      "text": "わかりました。…これで いかがですか。",
      "reading": "Wakarimashita. …Kore de ikaga desu ka."
    },
    {
      "speaker": "a",
      "text": "ありがとうございます。",
      "reading": "Arigatō gozaimasu."
    },
    {
      "speaker": "b",
      "text": "それから、重さを はかりますね。",
      "reading": "Sorekara, omosa o hakarimasu ne."
    },
    {
      "speaker": "a",
      "text": "なんキロですか。",
      "reading": "Nankiro desu ka."
    },
    {
      "speaker": "b",
      "text": "3キロです。",
      "reading": "Sankiro desu."
    },
    {
      "speaker": "a",
      "text": "すみませんが、送料も しらべて くださいませんか。",
      "reading": "Sumimasen ga, sōryō mo shirabete kudasaimasen ka."
    },
    {
      "speaker": "b",
      "text": "はい。3,500円です。",
      "reading": "Hai. Sanzen gohyaku en desu."
